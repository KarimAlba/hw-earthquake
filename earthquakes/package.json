{
  "name": "earthquakes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "npm run lint:oxlint && npm run lint:styles && npm run ts-check && npm run lint:prettier",
    "lint:oxlint": "oxlint",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\" -f unix",
    "lint:styles:fix": "stylelint \"src/**/*.{css,scss}\" --fix -f unix",
    "lint:prettier": "prettier --check \"**/*.{ts,tsx,json,md,scss}\"",
    "lint:prettier:fix": "prettier --write \"**/*.{ts,tsx,json,md,scss}\"",
    "lint:fix": "npm run lint:prettier:fix && npm run lint:styles:fix",
    "ts-check": "tsc -b",
    "pre-commit-lint": "npm run lint",
    "prepare": "cd .. && husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "husky": "^9.1.7",
    "oxlint": "^1.75.0",
    "prettier": "^3.8.3",
    "sass": "^1.102.0",
    "stylelint": "^17.12.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
